<?xml version="1.0"?>
<robot name="spider8">

  <material name="body_color"><color rgba="0.15 0.15 0.18 1"/></material>
  <material name="leg_color"><color rgba="0.8 0.2 0.2 1"/></material>
  <material name="foot_color"><color rgba="0.1 0.1 0.1 1"/></material>

  <link name="base_link">
    <visual><geometry><box size="0.42 0.3 0.06"/></geometry><material name="body_color"/></visual>
    <collision><geometry><box size="0.42 0.3 0.06"/></geometry></collision>
    <inertial><mass value="1.5"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
  </link>

  <!-- Leg l1 -->
  <link name="l1_upper">
    <visual><origin xyz="0 0.07 0" rpy="-1.5708 0 0"/><geometry><cylinder radius="0.02" length="0.14"/></geometry><material name="leg_color"/></visual>
    <collision><origin xyz="0 0.07 0" rpy="-1.5708 0 0"/><geometry><cylinder radius="0.02" length="0.14"/></geometry></collision>
    <inertial><mass value="0.04"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="l1_hip" type="revolute">
    <parent link="base_link"/><child link="l1_upper"/>
    <origin xyz="0.15 0.15 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.7" upper="0.7" effort="15" velocity="6"/>
  </joint>

  <link name="l1_lower">
    <visual><origin xyz="0 0 -0.08" rpy="0 0 0"/><geometry><cylinder radius="0.016" length="0.16"/></geometry><material name="foot_color"/></visual>
    <collision><origin xyz="0 0 -0.08" rpy="0 0 0"/><geometry><cylinder radius="0.016" length="0.16"/></geometry></collision>
    <inertial><mass value="0.02"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="l1_knee" type="revolute">
    <parent link="l1_upper"/><child link="l1_lower"/>
    <origin xyz="0 0.14 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.3" upper="1.4" effort="15" velocity="6"/>
  </joint>

