  </link>
  <joint name="l1_knee" type="revolute">
    <parent link="l1_upper"/><child link="l1_lower"/>
    <origin xyz="0 0.24 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.3" upper="1.4" effort="25" velocity="6"/>
  </joint>
  <link name="l1_foot">
