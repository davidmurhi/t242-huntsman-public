<?xml version="1.0"?>
<robot name="spider8_v4_longbody">

  <material name="body_color"><color rgba="0.15 0.15 0.18 1"/></material>
  <material name="leg_color"><color rgba="0.8 0.2 0.2 1"/></material>
  <material name="foot_color"><color rgba="0.1 0.1 0.1 1"/></material>

  <link name="base_link">
    <visual><geometry><box size="1 0.3 0.06"/></geometry><material name="body_color"/></visual>
    <collision><geometry><box size="1 0.3 0.06"/></geometry></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.03" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/></inertial>
  </link>

  <!-- Leg l1 -->
  <link name="l1_upper">
    <visual><origin xyz="0 0.12 0" rpy="-1.5708 0 0"/><geometry><cylinder radius="0.028" length="0.24"/></geometry><material name="leg_color"/></visual>
    <collision><origin xyz="0 0.12 0" rpy="-1.5708 0 0"/><geometry><cylinder radius="0.028" length="0.24"/></geometry></collision>
    <inertial><mass value="0.08"/><inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/></inertial>
  </link>
  <joint name="l1_hip" type="revolute">
    <parent link="base_link"/><child link="l1_upper"/>
    <origin xyz="0.4 0.16 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.7" upper="0.7" effort="25" velocity="6"/>
  </joint>

  <link name="l1_lower">
    <visual><origin xyz="0 0 -0.15" rpy="0 0 0"/><geometry><cylinder radius="0.024" length="0.3"/></geometry><material name="foot_color"/></visual>
