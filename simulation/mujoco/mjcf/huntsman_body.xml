<!--
  Project Huntsman — Step 1: Body only
  T242 | IFB398 26se2 | V Source Development

  WHAT THIS IS:
    The body shell sitting on the floor. No legs, no joints, no gait.
    Goal: confirm the physical dimensions look right before we build anything else.

  BODY DESIGN RATIONALE:
    - 0.38m long x 0.22m wide: fits Pi5 + ESP32 + 3S LiPo side by side
    - 0.07m tall: minimum height to house electronics stack properly
    - Mass 0.447kg: real component mass budget (Pi5 + ESP32 + LiPo + shell + wiring)
    - Inertia computed from box formula, not guessed
    - Front sensor bay cutout shown as separate geom (visual only, no physics change)
    - Colour: neutral grey — will be styled later per Craig's spec

  NEXT STEPS (do not add yet):
    Step 2 — one leg (L1 only), correct coxa/femur/tibia geometry
    Step 3 — all 8 legs, static standing pose
    Step 4 — single leg moves, joint range check
    Step 5 — wave gait, flat ground
    Step 6 — obstacles + contact sensors
    Step 7 — Gymnasium wrapper for Kai
-->
<mujoco model="huntsman_step1_body">

  <compiler angle="radian" autolimits="true"/>

  <option
    gravity="0 0 -9.81"
    timestep="0.002"
    integrator="RK4"
    solver="Newton"
    iterations="50"
    tolerance="1e-10"/>

  <default>
    <geom friction="0.8 0.1 0.05" condim="3"
          solimp="0.9 0.95 0.001 0.5 2"
          solref="0.02 1"/>
  </default>

  <asset>
    <!-- Checkerboard floor so we can see orientation clearly -->
    <texture name="grid" type="2d" builtin="checker"
             rgb1="0.28 0.28 0.28" rgb2="0.35 0.35 0.35"
             width="512" height="512"/>
    <material name="floor_mat" texture="grid" texrepeat="6 6"
              reflectance="0.0" shininess="0.0"/>

    <!-- Body shell: neutral dark grey -->
    <material name="body_mat" rgba="0.30 0.30 0.30 1"/>
    <!-- Front sensor bay: slightly lighter panel -->
    <material name="sensor_mat" rgba="0.22 0.22 0.22 1"/>
    <!-- Internal detail: very subtle contrast -->
    <material name="detail_mat" rgba="0.38 0.38 0.38 1"/>
  </asset>

  <worldbody>

    <!-- Lighting: three-point so the grey shell reads clearly -->
    <light name="key"  pos="2 -1 4" dir="-0.4 0.2 -1"
           diffuse="0.85 0.85 0.85" specular="0.1 0.1 0.1" castshadow="true"/>
    <light name="fill" pos="-3 2 3"  dir="0.6 -0.4 -0.8"
           diffuse="0.35 0.35 0.35" specular="0 0 0"/>
    <light name="rim"  pos="0 4 2"   dir="0 -1 -0.5"
           diffuse="0.20 0.20 0.20" specular="0 0 0"/>

    <!-- Floor -->
    <geom name="floor" type="plane" size="6 6 0.1"
          material="floor_mat"
          friction="1.0 0.1 0.05"
          solimp="0.999 0.9999 0.001 0.5 2"
          solref="0.004 1"/>

    <!--
      BODY — sits directly on floor for step 1.
      Uses freejoint so it can settle under gravity naturally.
      Position: centre of body at z = H/2 = 0.035m above floor.

      Dims: half-sizes for MuJoCo box geom
        x (front-back) = 0.38/2 = 0.190m
        y (left-right)  = 0.22/2 = 0.110m
        z (up-down)     = 0.07/2 = 0.035m

      Mass: 0.447kg (real hardware budget)
      Inertia: computed from box formula
        Ixx = 0.00199, Iyy = 0.00556, Izz = 0.00718
    -->
    <body name="torso" pos="0 0 0.035">
      <freejoint name="root"/>

      <inertial
        pos="0 0 0"
        mass="0.447"
        diaginertia="0.00199 0.00556 0.00718"/>

      <!-- Main shell -->
      <geom name="body_shell"
            type="box"
            size="0.190 0.110 0.035"
            material="body_mat"
            solimp="0.9 0.95 0.001 0.5 2"
            solref="0.02 1"/>

      <!--
        Front sensor bay panel — sits flush at front face, slightly inset.
        Visual only (no separate physics body needed at this stage).
        Width: 0.06m (fits a camera module + depth sensor side by side)
        Height: full body height
      -->
      <geom name="sensor_bay"
            type="box"
            size="0.008 0.050 0.034"
            pos="0.182 0 0"
            material="sensor_mat"
            solimp="0.9 0.95 0.001 0.5 2"
            solref="0.02 1"/>

      <!--
        Leg attachment pads — 8 small raised geoms showing where legs will connect.
        4 per side, evenly spaced along the body length.
        x positions: front pair ±0.135, second ±0.045, third -0.045, rear -0.135
        y position: ±0.110 (flush with body side edge)
        These are visual markers only — the actual leg joints replace them in step 2.
      -->
      <!-- Left side (y positive) -->
      <geom name="pad_l1" type="box" size="0.018 0.006 0.010" pos=" 0.135  0.116 0.010" material="detail_mat"/>
      <geom name="pad_l2" type="box" size="0.018 0.006 0.010" pos=" 0.045  0.116 0.010" material="detail_mat"/>
      <geom name="pad_l3" type="box" size="0.018 0.006 0.010" pos="-0.045  0.116 0.010" material="detail_mat"/>
      <geom name="pad_l4" type="box" size="0.018 0.006 0.010" pos="-0.135  0.116 0.010" material="detail_mat"/>
      <!-- Right side (y negative) -->
      <geom name="pad_r1" type="box" size="0.018 0.006 0.010" pos=" 0.135 -0.116 0.010" material="detail_mat"/>
      <geom name="pad_r2" type="box" size="0.018 0.006 0.010" pos=" 0.045 -0.116 0.010" material="detail_mat"/>
      <geom name="pad_r3" type="box" size="0.018 0.006 0.010" pos="-0.045 -0.116 0.010" material="detail_mat"/>
      <geom name="pad_r4" type="box" size="0.018 0.006 0.010" pos="-0.135 -0.116 0.010" material="detail_mat"/>

    </body>

  </worldbody>

</mujoco>
