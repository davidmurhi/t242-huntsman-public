<!--
  Project Huntsman — Step 2: Body + L1 leg only
  T242 | IFB398 26se2 | V Source Development

  ONE LEG — front-left (L1).
  Geometry computed from first principles, not copied from old model:

    Attachment point on body: x=+0.135, y=+0.110, z=+0.010

    Coxa  (0.08m): horizontal, angled 30° forward from pure lateral
                   This is how real spider front legs work — reach forward
                   Z-axis hip joint (yaw) range: ±0.6 rad

    Femur (0.14m): drops near-vertical with 10° outward lean
                   Gives the leg a natural wide stance without splaying flat
                   X-axis knee joint (pitch) range: -0.3 to +1.4 rad

    Tibia (0.16m): angles 15.8° inward, foot lands ~under body CoM
                   Longer than femur for better push-off leverage
                   X-axis ankle joint (pitch) range: -0.6 to +0.6 rad

    Foot: sphere r=0.030m, high friction, touch sensor site

  Computed foot position (body centre = origin):
    x=+0.175  y=+0.160  z=-0.282
  → Body clearance when standing on all 8: ~0.247m (clears ~10cm debris)
  → Full robot mass when complete: ~1.207 kg

  Body sitting on ground for this step — full standing height verified in step 3.
-->
<mujoco model="huntsman_step2_l1">

  <compiler angle="radian" autolimits="true"/>

  <option
    gravity="0 0 -9.81"
    timestep="0.002"
    integrator="RK4"
    solver="Newton"
    iterations="50"
    tolerance="1e-10"/>

  <default>
    <!-- Leg joints: realistic damping for servo-driven robot -->
    <joint damping="0.8" armature="0.01" limited="true"/>
    <!-- Leg segments: slightly higher friction than body -->
    <geom friction="0.8 0.1 0.05" condim="3"
          solimp="0.9 0.95 0.001 0.5 2" solref="0.02 1"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker"
             rgb1="0.28 0.28 0.28" rgb2="0.35 0.35 0.35"
             width="512" height="512"/>
    <material name="floor_mat"   texture="grid" texrepeat="6 6" reflectance="0.0"/>
    <material name="body_mat"    rgba="0.30 0.30 0.30 1"/>
    <material name="sensor_mat"  rgba="0.22 0.22 0.22 1"/>
    <material name="detail_mat"  rgba="0.38 0.38 0.38 1"/>
    <!-- Leg segments: capsule colour slightly lighter than body so joints read clearly -->
    <material name="coxa_mat"    rgba="0.50 0.50 0.50 1"/>
    <material name="femur_mat"   rgba="0.42 0.42 0.42 1"/>
    <material name="tibia_mat"   rgba="0.36 0.36 0.36 1"/>
    <material name="foot_mat"    rgba="0.18 0.18 0.18 1"/>
  </asset>

  <worldbody>

    <light name="key"  pos="2 -1 4"  dir="-0.4 0.2 -1"
           diffuse="0.85 0.85 0.85" specular="0.1 0.1 0.1" castshadow="true"/>
    <light name="fill" pos="-3 2 3"  dir="0.6 -0.4 -0.8"
           diffuse="0.35 0.35 0.35" specular="0 0 0"/>
    <light name="rim"  pos="0 4 2"   dir="0 -1 -0.5"
           diffuse="0.20 0.20 0.20" specular="0 0 0"/>

    <geom name="floor" type="plane" size="6 6 0.1"
          material="floor_mat"
          friction="1.2 0.1 0.05"
          solimp="0.999 0.9999 0.001 0.5 2" solref="0.004 1"/>

    <!-- ── BODY ───────────────────────────────────────────── -->
    <body name="torso" pos="0 0 0.035">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="0.447"
                diaginertia="0.00199 0.00556 0.00718"/>

      <geom name="body_shell" type="box"
            size="0.190 0.110 0.035" material="body_mat"
            solimp="0.9 0.95 0.001 0.5 2" solref="0.02 1"/>

      <geom name="sensor_bay" type="box"
            size="0.008 0.050 0.034" pos="0.182 0 0" material="sensor_mat"
            solimp="0.9 0.95 0.001 0.5 2" solref="0.02 1"/>

      <!-- Leg pads: L1 will be replaced by the actual leg below.
           Other 7 remain as visual placeholders. -->
      <geom name="pad_l2" type="box" size="0.018 0.006 0.010" pos=" 0.045  0.116 0.010" material="detail_mat"/>
      <geom name="pad_l3" type="box" size="0.018 0.006 0.010" pos="-0.045  0.116 0.010" material="detail_mat"/>
      <geom name="pad_l4" type="box" size="0.018 0.006 0.010" pos="-0.135  0.116 0.010" material="detail_mat"/>
      <geom name="pad_r1" type="box" size="0.018 0.006 0.010" pos=" 0.135 -0.116 0.010" material="detail_mat"/>
      <geom name="pad_r2" type="box" size="0.018 0.006 0.010" pos=" 0.045 -0.116 0.010" material="detail_mat"/>
      <geom name="pad_r3" type="box" size="0.018 0.006 0.010" pos="-0.045 -0.116 0.010" material="detail_mat"/>
      <geom name="pad_r4" type="box" size="0.018 0.006 0.010" pos="-0.135 -0.116 0.010" material="detail_mat"/>

      <!-- ── L1 LEG ──────────────────────────────────────── -->
      <!--
        COXA — attaches at front-left pad position on body side
        pos: the pad location on the body surface
        Joint: hip — Z-axis yaw (horizontal swing, Craig spec)
        Capsule drawn from local origin out to coxa tip
          tip local coords: [0.040, 0.069, 0.0]  (30° forward from lateral)
      -->
      <body name="l1_coxa" pos="0.135 0.110 0.010">
        <inertial pos="0.020 0.035 0" mass="0.040"
                  diaginertia="0.000035 0.000035 0.000010"/>
        <joint name="l1_hip" type="hinge" axis="0 0 1"
               range="-0.6 0.6" damping="0.8" armature="0.01"/>
        <geom name="l1_coxa_g" type="capsule" size="0.016"
              fromto="0 0 0  0.040 0.069 0"
              material="coxa_mat"/>

        <!--
          FEMUR — attaches at coxa tip
          pos: coxa tip in coxa-local frame
          Joint: knee — X-axis pitch (lift/lower, Craig spec)
          10° outward lean: femur drops to [0, +0.024, -0.138]
        -->
        <body name="l1_femur" pos="0.040 0.069 0">
          <inertial pos="0 0.012 -0.070" mass="0.035"
                    diaginertia="0.000030 0.000030 0.000008"/>
          <joint name="l1_knee" type="hinge" axis="1 0 0"
                 range="-0.3 1.4" damping="0.8" armature="0.01"/>
          <geom name="l1_femur_g" type="capsule" size="0.014"
                fromto="0 0 0  0 0.024 -0.138"
                material="femur_mat"/>

          <!--
            TIBIA — attaches at femur tip
            pos: femur tip in femur-local frame
            Joint: ankle — X-axis pitch (ground adaptation)
            15.8° inward: tibia goes to [0, -0.044, -0.154]
            Foot sphere at tibia tip, r=0.030, touch sensor site
          -->
          <body name="l1_tibia" pos="0 0.024 -0.138">
            <inertial pos="0 -0.022 -0.077" mass="0.020"
                      diaginertia="0.000018 0.000018 0.000004"/>
            <joint name="l1_ankle" type="hinge" axis="1 0 0"
                   range="-0.6 0.6" damping="0.5" armature="0.008"/>
            <geom name="l1_tibia_g" type="capsule" size="0.012"
                  fromto="0 0 0  0 -0.044 -0.154"
                  material="tibia_mat"/>
            <!-- Foot: high friction sphere with touch sensor -->
            <geom name="l1_foot" type="sphere" size="0.030"
                  pos="0 -0.044 -0.154"
                  material="foot_mat"
                  friction="2.0 0.2 0.01"
                  solimp="0.999 0.9999 0.001 0.5 2" solref="0.004 1"
                  condim="4"/>
            <site name="l1_touch" pos="0 -0.044 -0.154" size="0.032"/>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <!-- Touch sensor on L1 foot — used from step 6 onward -->
  <sensor>
    <touch name="l1_sensor" site="l1_touch"/>
  </sensor>

  <!-- Self-collision exclusions for L1 -->
  <contact>
    <exclude body1="torso"    body2="l1_coxa"/>
    <exclude body1="l1_coxa"  body2="l1_femur"/>
    <exclude body1="l1_femur" body2="l1_tibia"/>
  </contact>

  <!-- Actuators — position control, same as Craig's servo pipeline -->
  <actuator>
    <position name="l1_hip"   joint="l1_hip"   kp="40"
              forcerange="-40 40" ctrlrange="-0.6 0.6"/>
    <position name="l1_knee"  joint="l1_knee"  kp="55"
              forcerange="-55 55" ctrlrange="-0.3 1.4"/>
    <position name="l1_ankle" joint="l1_ankle" kp="30"
              forcerange="-30 30" ctrlrange="-0.6 0.6"/>
  </actuator>

  <!--
    Home pose: knee slightly bent so leg hangs naturally.
    hip=0 (straight out), knee=0.45 (slight bend), ankle=0.0
  -->
  <keyframe>
    <key name="home" qpos="0 0 0.035 1 0 0 0   0 0.45 0"/>
  </keyframe>

</mujoco>
